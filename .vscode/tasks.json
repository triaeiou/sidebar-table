{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build clean",
            "type": "shell",
            "command": "Write-host Building clean... ; rm -ea 0 -R -Force ./dist/*, ./bin/*",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Build py",
            "type": "shell",
            "command": "Write-host Building PY... ; ls ./src/py/*.py | ? { -not (Test-Path ('./bin/' + $_.Name) -PathType Leaf) -or (Test-Path ('./bin/' + $_.Name) -OlderThan $_.LastWriteTime) } | % {$_.FullName} | cp -ea 0  -Force -Destination (New-Item -Type Directory -Force ./bin) | Out-Null",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Build config",
            "type": "shell",
            "command": "Write-host Building config... ; cp -ea 0  ./src/config/* -Destination (New-Item -Type Directory -Force ./bin) | Out-Null",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Build update",
            "type": "shell",
            "command": "Write-host Building update... ; rm -ea 0 -R -Force ./dist/*; rm -ea 0 -R -Force ./bin/__pycache__; Get-ChildItem -Path ./bin/*, ./README.md, ./LICENSE | Compress-Archive -ea 0 -Force -DestinationPath ./dist/update.zip; pandoc -t ${env:CODEPATH}/Anki/addons/pandoc-anki-addon-writer/anki-addon.lua ./README.md -o ./dist/update.txt | Out-Null",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Build all",
            "dependsOn": [
                "Build py",
                "Build config",
                "Build update"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}